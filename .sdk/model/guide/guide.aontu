# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"

# FoodEntriesResponse wraps the collection in entries, alongside daily totals.
# The inferred guide omits this envelope mapping; retain it across regeneration.
guide: entity: food_entry: path: '/food_entries': op: list: transform: res: "`body.entries`"

