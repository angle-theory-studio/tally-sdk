{
  "name": "@angle-theory-studio/tally-sdk",
  "version": "0.0.1",
  "description": "Unofficial generated TypeScript SDK for the Tally public API. Not affiliated with or endorsed by the upstream API provider.",
  "keywords": [
    "voxgig",
    "sdk",
    "generated-sdk",
    "openapi",
    "api-client",
    "tally"
  ],
  "homepage": "https://github.com/angle-theory-studio/tally-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angle-theory-studio/tally-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/angle-theory-studio/tally-sdk/issues"
  },
  "main": "dist/TallySDK.js",
  "type": "commonjs",
  "types": "dist/TallySDK.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test-concurrency=1 --test \"dist-test/**/*.test.js\"",
    "test-some": "node -e \"const r=require('node:child_process').spawnSync(process.execPath,['--enable-source-maps','--experimental-test-isolation=none','--test-name-pattern='+(process.env.TEST_PATTERN||'.*'),'--test','dist-test/**/*.test.js'],{stdio:'inherit'});if(r.error)throw r.error;process.exit(r.status??1)\"",
    "test-utility": "node --enable-source-maps --test test/utility/*.test.ts",
    "pretest-coverage": "npm run build",
    "test-coverage": "node --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"**/dist-test/**\" --test-coverage-lines=85 --test-coverage-branches=68 --test-coverage-functions=88 --test \"dist-test/**/*.test.js\"",
    "watch": "tsc --build src test -w",
    "build": "node -e \"for (const p of ['dist','dist-test']) require('node:fs').rmSync(p,{recursive:true,force:true})\" && tsc --build src test --force",
    "clean": "node -e \"for (const p of ['node_modules','dist','dist-test']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "reset": "npm run clean && npm ci && npm test"
  },
  "author": {
    "name": "angle-theory-studio",
    "url": "https://github.com/angle-theory-studio"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  }
}
